---
const hobbies = [
  {
    name: "Making, Hardware & Electronics",
    icon: "🛠️",
    description:
      "Exploring the world of 3D printing, circuits, microcontrollers, and embedded systems to create innovative hardware and electronic devices.",
  },
  {
    name: "Robotics",
    icon: "🤖",
    description:
      "Exploring robotic workflows, intelligent hardware, and human-machine collaboration.",
  },
  {
    name: "Books, Comic Books & Manga",
    icon: "📚",
    description:
      "Diving into stories, ideas, and knowledge through various literary forms to expand imagination and understanding. ",
  },
  {
    name: "Traveling",
    icon: "🧭",
    description:
      "Discovering new environments, people, and local cultures to expand perspective.",
  },
  {
    name: "Cooking",
    icon: "🍳",
    description:
      "Experimenting with recipes, flavors, and cooking techniques to create delicious meals.",
  },
  {
    name: "Fitness, Health & Wellness",
    icon: "🏋️‍♂️",
    description:
      "Maintaining physical fitness, mental well-being, and a balanced lifestyle.",
  },
];
---

<section
  id="hobbies"
  class="border-y border-amber-700/30 bg-stone-950 px-5 py-20 lg:px-8 dark:bg-stone-950"
>
  <div class="mx-auto w-full max-w-6xl">
    <h2 class="text-3xl font-bold text-amber-100">Hobbies</h2>
    <p class="mt-3 max-w-3xl text-sm leading-7 text-amber-100/80">
      The curiosity map behind my work style. These interests feed how I design
      products, systems, and experiences.
    </p>

    <div class="mt-10 grid gap-6 lg:grid-cols-2">
      {
        hobbies.map((hobby, idx) => (
          <article
            class={`animate-fade-up rounded-2xl border border-amber-500/25 bg-linear-to-br from-stone-900 to-stone-800 p-5 ${idx % 2 === 1 ? "animate-delay-1" : ""}`}
          >
            <h3 class="text-base font-semibold text-amber-100">
              <span class="mr-2" aria-hidden="true">
                {hobby.icon}
              </span>
              {hobby.name}
            </h3>

            <div class="mt-4 h-2 rounded-full bg-stone-700/80">
              <div
                class={`h-2 rounded-full bg-linear-to-r from-amber-500 to-amber-300 w-full`}
              />
            </div>
            <p class="mt-4 text-sm leading-7 text-stone-200/90">
              {hobby.description}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
