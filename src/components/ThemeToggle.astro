---
import { Moon, Sun } from "@lucide/astro";
---

<button
  class="group inline-flex h-10 items-center gap-2 rounded-lg border border-amber-600/40 bg-amber-500/10 px-3 text-xs font-semibold uppercase tracking-[0.2em] text-amber-200 transition hover:border-amber-500 hover:bg-amber-500/20 hover:text-amber-100"
  type="button"
  aria-label="Activate dark theme"
  data-theme-toggle
>
  <Sun class="h-4 w-4" aria-hidden="true" data-theme-icon-light />
  <Moon class="hidden h-4 w-4" aria-hidden="true" data-theme-icon-dark />
</button>

<script is:inline>
  (function () {
    const root = document.documentElement;
    const button = document.querySelector("[data-theme-toggle]");
    const lightIcon = document.querySelector("[data-theme-icon-light]");
    const darkIcon = document.querySelector("[data-theme-icon-dark]");
    const storedTheme = localStorage.getItem("theme");
    const prefersDark = window.matchMedia(
      "(prefers-color-scheme: dark)",
    ).matches;

    const applyTheme = (theme) => {
      const isDark = theme === "dark";

      if (isDark) {
        root.classList.add("dark");
      } else {
        root.classList.remove("dark");
      }

      lightIcon?.classList.toggle("hidden", isDark);
      darkIcon?.classList.toggle("hidden", !isDark);
      button?.setAttribute(
        "aria-label",
        isDark ? "Activate light theme" : "Activate dark theme",
      );
    };

    applyTheme(storedTheme ?? (prefersDark ? "dark" : "light"));

    button?.addEventListener("click", () => {
      const nextTheme = root.classList.contains("dark") ? "light" : "dark";
      applyTheme(nextTheme);
      localStorage.setItem("theme", nextTheme);
    });
  })();
</script>
