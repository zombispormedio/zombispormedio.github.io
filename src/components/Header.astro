---
import ThemeToggle from "./ThemeToggle.astro";

const links = [
  { href: "#skills", label: "Skills" },
  { href: "#hobbies", label: "Hobbies" },
  { href: "#experience", label: "Experience" },
  { href: "#projects", label: "Projects" },
];
---

<header
  class="sticky top-0 z-50 border-b border-amber-700/30 bg-stone-950/80 backdrop-blur dark:border-stone-700/70 dark:bg-stone-950/80"
>
  <div
    class="mx-auto flex w-full max-w-6xl items-center justify-between px-5 py-4 lg:px-8"
  >
    <a
      href="#top"
      class="text-sm font-semibold uppercase tracking-[0.22em] text-amber-300"
      >Xavier Serrano</a
    >

    <div class="flex items-center gap-3 md:gap-6">
      <button
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-amber-600/40 bg-amber-500/10 text-amber-100 transition hover:border-amber-500 hover:bg-amber-500/20 md:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open navigation menu"
        data-mobile-menu-toggle
      >
        <span class="sr-only">Open menu</span>
        <svg
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
      <nav
        class="hidden items-center gap-5 md:flex"
        aria-label="Main navigation"
      >
        {
          links.map((link) => (
            <a
              href={link.href}
              class="text-xs font-semibold uppercase tracking-[0.18em] text-amber-100/80 transition hover:text-amber-200 dark:text-stone-300 dark:hover:text-amber-200"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
      <ThemeToggle />
    </div>
  </div>

  <nav
    id="mobile-menu"
    class="hidden border-t border-amber-700/30 bg-stone-950/95 px-5 py-4 md:hidden"
    aria-label="Mobile navigation"
    data-mobile-menu
  >
    <ul class="flex flex-col gap-3">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="block rounded-md border border-amber-600/25 bg-amber-500/10 px-3 py-2 text-xs font-semibold uppercase tracking-[0.18em] text-amber-100 transition hover:border-amber-500 hover:bg-amber-500/20"
              data-mobile-menu-link
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script is:inline>
  (() => {
    const toggle = document.querySelector("[data-mobile-menu-toggle]");
    const menu = document.querySelector("[data-mobile-menu]");
    const links = document.querySelectorAll("[data-mobile-menu-link]");

    if (!toggle || !menu) return;

    const setOpen = (isOpen) => {
      toggle.setAttribute("aria-expanded", String(isOpen));
      toggle.setAttribute(
        "aria-label",
        isOpen ? "Close navigation menu" : "Open navigation menu",
      );
      menu.classList.toggle("hidden", !isOpen);
    };

    toggle.addEventListener("click", () => {
      const open = toggle.getAttribute("aria-expanded") === "true";
      setOpen(!open);
    });

    links.forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    window.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setOpen(false);
    });

    window.addEventListener("resize", () => {
      if (window.innerWidth >= 768) setOpen(false);
    });
  })();
</script>
