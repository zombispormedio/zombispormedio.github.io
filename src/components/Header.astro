---
import ThemeToggle from "./ThemeToggle.astro";

const links = [
  { href: "#skills", label: "Skills" },
  { href: "#hobbies", label: "Hobbies" },
  { href: "#experience", label: "Experience" },
  { href: "#projects", label: "Projects" },
];
---

<header
  class="sticky top-0 z-50 border-b border-amber-700/30 bg-stone-950/80 backdrop-blur dark:border-stone-700/70 dark:bg-stone-950/80"
>
  <div
    class="mx-auto flex w-full max-w-6xl items-center justify-between px-5 py-4 lg:px-8"
  >
    <a
      href="#top"
      class="text-sm font-semibold uppercase tracking-[0.22em] text-amber-300"
      >Xavier Serrano</a
    >

    <div class="flex items-center gap-6">
      <nav
        class="hidden items-center gap-5 md:flex"
        aria-label="Main navigation"
      >
        {
          links.map((link) => (
            <a
              href={link.href}
              class="text-xs font-semibold uppercase tracking-[0.18em] text-amber-100/80 transition hover:text-amber-200 dark:text-stone-300 dark:hover:text-amber-200"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
      <ThemeToggle />
    </div>
  </div>
</header>
