---
const skillGroups = [
  {
    title: "Languages",
    items: ["Go", "TypeScript", "JavaScript", "Node.js", "Java", "SQL"],
  },
  {
    title: "Infrastructure and Platform",
    items: ["Kubernetes", "Istio", "Terraform", "AWS", "Azure", "Google Cloud"],
  },
  {
    title: "DevOps and Observability",
    items: [
      "GitOps",
      "CI/CD Pipelines",
      "ArgoCD",
      "Argo Workflows",
      "OpenTelemetry",
      "Honeycomb",
      "Incident Management",
    ],
  },
  {
    title: "Web and Product Engineering",
    items: ["React", "GraphQL", "TailwindCSS", "Vite"],
  },
];
---

<section id="skills" class="mx-auto w-full max-w-6xl px-5 py-20 lg:px-8">
  <h2 class="text-3xl font-bold text-stone-900 dark:text-amber-100">Skills</h2>
  <p
    class="mt-3 max-w-3xl text-sm leading-7 text-stone-700 dark:text-stone-300"
  >
    A practical blend of platform reliability, product engineering, and
    operations-first thinking.
  </p>

  <div class="mt-10 grid gap-6 md:grid-cols-2">
    {
      skillGroups.map((group, idx) => (
        <article
          class={`animate-fade-up rounded-2xl border border-amber-600/30 bg-amber-50/70 p-6 shadow-sm transition hover:shadow-lg dark:border-amber-500/20 dark:bg-stone-900/70 ${idx === 1 ? "animate-delay-1" : ""} ${idx === 2 ? "animate-delay-2" : ""} ${idx === 3 ? "animate-delay-3" : ""}`}
        >
          <h3 class="text-sm font-semibold uppercase tracking-[0.18em] text-amber-700 dark:text-amber-300">
            {group.title}
          </h3>
          <ul class="mt-4 flex flex-wrap gap-2">
            {group.items.map((item) => (
              <li class="rounded-md border border-amber-500/30 bg-white px-3 py-1 text-xs font-medium text-stone-700 dark:border-amber-500/30 dark:bg-stone-800 dark:text-stone-100">
                {item}
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</section>
